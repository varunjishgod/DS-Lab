#include<iostream>
#include<string>
#include<cctype>
using namespace std;

class Stack{
    char arr[100];
    int top;

    public:
    Stack(){
        top = -1;
    }
    bool isEmpty(){
        return top == -1;
    }

    void push(char ch){
        arr[++top] = ch;
    }
    char pop(){
        return arr[top--];
    }
    char peek(){
        return arr[top];
    }

};

class InfixToPostfix{
    int priority(char ch){
        if(ch == '^') return 3;
        if(ch == '*' || ch == '/') return 2;
        if(ch == '+' || ch == '-') return 1;
        if(ch == '(') return 0;
        return -1;
    }

    bool isOperand(char ch){
        return isalnum(ch);
    }

    public:
    string convert(string formula){
        Stack st;
        string postfix = "";

        for(int i = 0; i<formula.length(); i++){
            char ch = formula[i];

            if(isOperand(ch)) postfix += ch;

            else if(ch == '(') st.push(ch);

            else if(ch == ')'){
                while(!st.isEmpty()&&st.peek()!='('){
                    postfix += st.pop();
                }

                if(!st.isEmpty()) st.pop();
            }

            else{
                while(!st.isEmpty()&&priority(ch)<=priority(st.peek())){
                    postfix+=st.pop();
                }
                st.push(ch);
            }
        }
            while(!st.isEmpty()){
                postfix+=st.pop();
            }
            return postfix;
    }
};

int main(){
    InfixToPostfix converter;

    string formula;

    cout << "Enter infix expression: ";
    cin >> formula;

    cout << "Postfix experssion: " << converter.convert(formula);
    return 0;
}
